{
  "name": "@local/dsh-appearance-studio",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Appearance studio with installed fonts, bounded font selection, and real application glass.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "fonts.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gazesphotograph/dsh-appearance-studio.git"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test": "node tests/appearance-regression.mjs"
  }
}
